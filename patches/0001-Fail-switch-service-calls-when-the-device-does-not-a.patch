 custom_components/bravia_quad/switch.py       | 66 +++++++++++--------
 .../bravia_quad/translations/en.json          |  3 +
 .../bravia_quad/translations/fr.json          |  3 +
 tests/test_switch.py                          | 27 ++++++++
 5 files changed, 73 insertions(+), 29 deletions(-)

